{
  "id": "./",
  "name": "Órbita",
  "short_name": "Órbita",
  "description": "Tu música, tu DJ: reproductor personal con DJ que habla, ruleta, modo radio y mezclas según el día y la hora.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#06050b",
  "theme_color": "#06050b",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/ahora.png",
      "sizes": "540x1170",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Ahora: la DJ, la ruleta y el modo radio"
    },
    {
      "src": "screenshots/suena.png",
      "sizes": "540x1170",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Ahora suena, con la portada a pantalla completa"
    },
    {
      "src": "screenshots/ajustes.png",
      "sizes": "540x1170",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Temas y voces a tu gusto"
    }
  ],
  "shortcuts": [
    {
      "name": "Girar la ruleta",
      "short_name": "Ruleta",
      "url": "./?action=ruleta",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Modo radio",
      "short_name": "Radio",
      "url": "./?action=radio",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Buscar canciones",
      "short_name": "Buscar",
      "url": "./#buscar",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".mp3",
            ".m4a",
            ".aac",
            ".flac",
            ".wav",
            ".ogg",
            ".opus"
          ]
        }
      ]
    }
  }
}